@page "/entry"
@attribute [Authorize]
@implements IDisposable

@inject NavigationManager Navigation
@inject ItemEntryService ItemService
@inject AppState AppState
@inject HttpClient Http
@inject AiService AiService

<MudText Typo="Typo.h5" Class="mb-4">录入物品</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudPaper Class="pa-2 mb-3" Style="background-color:#FFF3F0;border:1px solid #EF5350;color:#C62828">
        <MudText>@_errorMessage</MudText>
    </MudPaper>
}

<MudText Typo="Typo.subtitle2" Class="mb-2">照片（可选）</MudText>
<ImageUploader @ref="_imageUploader" PhotoCaptured="OnPhotoCaptured" />

@if (_isRecognizing)
{
    <MudText Color="Color.Info" Class="mb-2 mt-2">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        AI 识别中...
    </MudText>
}
@if (_recognitionError is not null)
{
    <MudText Color="Color.Warning" Class="mb-2 mt-2">@_recognitionError</MudText>
}

<MudTextField @bind-Value="_name" Label="物品名称" Variant="Variant.Outlined" Class="mb-3 mt-3" />
<MudTextField @bind-Value="_note" Label="备注" Variant="Variant.Outlined" Lines="2" Class="mb-3" />

<MudText Typo="Typo.subtitle2" Class="mb-2">选择位置</MudText>
<LocationTree SelectedLocationId="_selectedLocationId"
              SelectedLocationIdChanged="OnSelectedLocationChanged" />
<MudDivider Class="my-3" />

<MudText Typo="Typo.subtitle2" Class="mb-2">选择标签</MudText>
<TagFilter SelectedTagIds="_selectedTagIds"
           SelectedTagIdsChanged="OnSelectedTagsChanged" />

<MudDivider Class="my-3" />
<ContinuityBanner />

<MudButton Variant="Variant.Filled" Color="Color.Primary"
           FullWidth="true" OnClick="OnSaveAsync"
           Disabled="@(_saving || string.IsNullOrWhiteSpace(_name) || _selectedLocationId is null)">
    @(_saving ? "保存中..." : "保存")
</MudButton>

@code {
    private string _name = "";
    private string _note = "";
    private int? _selectedLocationId;
    private string? _selectedLocationName;
    private IReadOnlyCollection<int> _selectedTagIds = Array.Empty<int>();
    private PhotoCapture? _photo;
    private ImageUploader? _imageUploader;
    private bool _saving;
    private bool _isDisposed;
    private bool _isRecognizing;
    private string? _recognitionError;
    private string? _errorMessage;
    private CancellationTokenSource? _recognitionCts;

    protected override void OnInitialized()
    {
        if (AppState.ContinuousLocationId is not null)
        {
            _selectedLocationId = AppState.ContinuousLocationId;
            _selectedLocationName = AppState.ContinuousLocationName;
        }
    }

    private async Task OnPhotoCaptured(PhotoCapture photo)
    {
        _photo = photo;

        // 取消上一次尚未完成的 AI 识别
        _recognitionCts?.Cancel();
        _recognitionCts?.Dispose();
        _recognitionCts = new CancellationTokenSource();
        var token = _recognitionCts.Token;

        _isRecognizing = true;
        _recognitionError = null;
        StateHasChanged();

        try
        {
            var result = await AiService.RecognizeAsync(
                photo.Bytes, photo.ContentType, token);

            if (_isDisposed || token.IsCancellationRequested) return;

            if (result is not null)
            {
                if (string.IsNullOrWhiteSpace(_name))
                    _name = result.Name;
                if (!string.IsNullOrWhiteSpace(result.Note) && string.IsNullOrWhiteSpace(_note))
                    _note = result.Note;
            }
            else
            {
                _recognitionError = "AI 未能识别物品，请手动输入";
            }
        }
        catch (OperationCanceledException)
        {
            // 被新的拍照请求取消
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _recognitionError = "AI 识别失败，请手动输入";
        }
        finally
        {
            if (!_isDisposed && !token.IsCancellationRequested)
            {
                _isRecognizing = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        _recognitionCts?.Cancel();
        _recognitionCts?.Dispose();
    }

    private void RemovePhoto()
    {
        _photo = null;
        _imageUploader?.ClearPreview();
    }

    private Task OnSelectedLocationChanged(int? value)
    {
        _selectedLocationId = value;
        _selectedLocationName = null;
        return Task.CompletedTask;
    }

    private Task OnSelectedTagsChanged(IReadOnlyCollection<int> value)
    {
        _selectedTagIds = value;
        return Task.CompletedTask;
    }

    private async Task OnSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _selectedLocationId is null) return;

        _errorMessage = null;
        _saving = true;

        try
        {
            var tagIds = _selectedTagIds.ToList();
            var request = new CreateItemRequest(_name.Trim(), _selectedLocationId.Value, tagIds, _note.Trim());
            var itemId = await ItemService.CreateItemAsync(request);

            if (itemId is not null)
            {
                if (_photo is not null)
                {
                    await UploadPhotoAsync(itemId.Value, _photo);
                }

                var locationLabel = _selectedLocationName ?? $"位置 #{_selectedLocationId}";
                AppState.SetContinuousLocation(_selectedLocationId.Value, locationLabel);
                Navigation.NavigateTo("/");
                return;
            }

            _errorMessage = "保存失败，请检查输入后重试";
        }
        catch
        {
            _errorMessage = "保存时发生错误，请稍后重试";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UploadPhotoAsync(int itemId, PhotoCapture photo)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(photo.OpenReadStream());
            streamContent.Headers.ContentType = new(photo.ContentType);
            content.Add(streamContent, "file", photo.FileName);
            content.Add(new StringContent(itemId.ToString()), "itemId");

            await Http.PostAsync("api/images/upload", content);
        }
        catch
        {
            // 照片上传失败不阻断保存流程
        }
    }
}
