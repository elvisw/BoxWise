@page "/settings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">设置</MudText>

<div class="bw-settings-list">

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenAccountInfoDialog" @onkeydown="HandleAccountKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">账户信息</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">修改用户名</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenChangePasswordDialog" @onkeydown="HandlePasswordKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Medium" Class="mr-3" Color="Color.Secondary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">修改密码</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">修改登录密码</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenTwoFactorSetupDialog" @onkeydown="HandleTwoFactorKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Medium" Class="mr-3" Color="Color.Tertiary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">双因素认证</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    @_twoFactorStatusText
                </MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenLocationManageDialog" @onkeydown="HandleLocationKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">位置管理</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">管理收纳位置层级</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenTagManageDialog" @onkeydown="HandleTagKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Medium" Class="mr-3" Color="Color.Secondary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">标签管理</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">管理物品分类标签</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="GoAbout" @onkeydown="HandleAboutKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Medium" Class="mr-3" Color="Color.Tertiary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">关于</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">版本信息与开源许可</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="LogoutAsync" @onkeydown="HandleLogoutKey" @onkeydown:preventDefault>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Medium" Class="mr-3" Color="Color.Error" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Color="Color.Error" Style="font-weight:500;">退出登录</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">切换到其他账户</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

</div>

@code {
    private string _twoFactorStatusText = "加载中...";

    protected override async Task OnInitializedAsync()
    {
        await LoadTwoFactorStatusAsync();
    }

    private async Task LoadTwoFactorStatusAsync()
    {
        try
        {
            var status = await AuthService.GetTwoFactorStatusAsync();
            if (status is null)
            {
                _twoFactorStatusText = "设置 TOTP 两步验证";
            }
            else if (status.TwoFactorEnabled)
            {
                var methodName = status.TwoFactorMethod switch
                {
                    "TOTP" => "TOTP 验证器",
                    _ => status.TwoFactorMethod ?? "未知"
                };
                _twoFactorStatusText = $"已启用（{methodName}）";
            }
            else
            {
                _twoFactorStatusText = "设置 TOTP 两步验证";
            }
        }
        catch
        {
            _twoFactorStatusText = "设置 TOTP 两步验证";
        }
    }

    private async Task OpenAccountInfoDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<AccountInfoDialog>("账户信息", options);
    }

    private async Task OpenChangePasswordDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ChangePasswordDialog>("修改密码", options);
    }

    private async Task OpenTwoFactorSetupDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TwoFactorSetup>("双因素认证", options);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await LoadTwoFactorStatusAsync();
            StateHasChanged();
        }
    }

    private async Task OpenLocationManageDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<LocationManageDialog>("管理位置", options);
    }

    private async Task OpenTagManageDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<TagManageDialog>("管理标签", options);
    }

    private async Task LogoutAsync()
    {
        try { await AuthService.LogoutAsync(); }
        catch { }
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void GoAbout() => Navigation.NavigateTo("/about");

    private async void HandleAccountKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenAccountInfoDialog); }
    }

    private async void HandlePasswordKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenChangePasswordDialog); }
    }

    private async void HandleTwoFactorKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenTwoFactorSetupDialog); }
    }

    private async void HandleLocationKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenLocationManageDialog); }
    }

    private async void HandleTagKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenTagManageDialog); }
    }

    private async void HandleAboutKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { GoAbout(); }
    }

    private async void HandleLogoutKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await LogoutAsync(); }
    }

    private static async Task InvokeSafeAsync(Func<Task> action)
    {
        try { await action(); }
        catch { }
    }
}
