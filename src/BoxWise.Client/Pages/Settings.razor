@page "/settings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BoxWise.Shared.Dtos

@inject AuthService AuthService
@inject IConfiguration Config
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">设置</MudText>

<div class="bw-settings-list">

    <MudButton Href="@GetServerUrl("Identity/Account/Manage")"
               Target="_blank"
               StartIcon="@Icons.Material.Filled.Security"
               Color="Color.Primary"
               Variant="Variant.Text"
               Class="bw-settings-item pa-4 mb-1"
               FullWidth="true">
        <div class="d-flex align-center flex-grow-1">
            <div class="flex-grow-1" style="text-align:left;">
                <MudText Typo="Typo.body1" Style="font-weight:500;">管理账户设置</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">管理密码、邮箱与两步验证</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Default" Size="Size.Small" />
        </div>
    </MudButton>

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenPasskeyManageDialog" @onkeydown="HandlePasskeyKey">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Medium" Class="mr-3" Color="Color.Tertiary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">通行密钥管理</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">管理已注册的指纹/面容/硬件密钥</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenLocationManageDialog" @onkeydown="HandleLocationKey">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">位置管理</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">管理收纳位置层级</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="OpenTagManageDialog" @onkeydown="HandleTagKey">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Medium" Class="mr-3" Color="Color.Secondary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">标签管理</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">管理物品分类标签</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="GoAbout" @onkeydown="HandleAboutKey">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Medium" Class="mr-3" Color="Color.Tertiary" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Style="font-weight:500;">关于</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">版本信息与开源许可</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

    <MudDivider Class="my-3" />

    <div class="pa-4 mb-1 bw-settings-item" role="button" tabindex="0"
         @onclick="Logout" @onkeydown="HandleLogoutKey">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Medium" Class="mr-3" Color="Color.Error" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1" Color="Color.Error" Style="font-weight:500;">退出登录</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">切换到其他账户</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
        </div>
    </div>

</div>

@code {
    private string GetServerUrl(string path)
    {
        var apiBase = Config["ApiBaseUrl"];
        if (!string.IsNullOrEmpty(apiBase))
        {
            var trimmed = apiBase.TrimEnd('/');
            return $"{trimmed}/{path.TrimStart('/')}";
        }
        return $"/{path.TrimStart('/')}";
    }

    private async Task OpenPasskeyManageDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<PasskeyManageDialog>("通行密钥管理", options);
    }

    private async Task OpenLocationManageDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<LocationManageDialog>("管理位置", options);
    }

    private async Task OpenTagManageDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<TagManageDialog>("管理标签", options);
    }

    private void Logout()
    {
        Navigation.NavigateTo(GetServerUrl("Identity/Account/Logout?returnUrl=/"), forceLoad: true);
    }

    private void GoAbout() => Navigation.NavigateTo("/about");

    private async Task HandlePasskeyKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenPasskeyManageDialog); }
    }

    private async Task HandleLocationKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenLocationManageDialog); }
    }

    private async Task HandleTagKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { await InvokeSafeAsync(OpenTagManageDialog); }
    }

    private void HandleAboutKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { GoAbout(); }
    }

    private void HandleLogoutKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") { Logout(); }
    }

    private static async Task InvokeSafeAsync(Func<Task> action)
    {
        try { await action(); }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Settings] Unhandled exception: {ex.Message}");
        }
    }
}
