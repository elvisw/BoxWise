@page "/items/{id:int}"
@attribute [Authorize]

@using BoxWise.Shared.Dtos
@inject ItemService ItemService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
}
else if (_notFound)
{
    <MudText Typo="Typo.h5" Color="Color.Error">物品不存在</MudText>
}
else if (_item is not null)
{
    @if (_item.MediumPath is not null)
    {
        <img src="@($"{Http.BaseAddress}api/images/{_item.Id}?type=medium")" style="max-width:100%;max-height:400px;border-radius:4px" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 my-3" Style="text-align:center;background:#F5F5F5">
            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.caption">暂无照片</MudText>
        </MudPaper>
    }

    <MudText Typo="Typo.h5" Class="mt-3">@_item.Name</MudText>

    <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-2">
        <strong>位置:</strong> @FormatLocationPath(_item.LocationPath, _item.LocationName, _item.LocationId)
    </MudText>

    @if (_item.TagNames is { Count: > 0 })
    {
        <div class="mt-1 d-flex flex-wrap" style="gap:4px;">
            <MudText Typo="Typo.body2"><strong>标签:</strong></MudText>
            @foreach (var tag in _item.TagNames)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@tag</MudChip>
            }
        </div>
    }

    @if (_item.Note is not null)
    {
        <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-1">
            <strong>备注:</strong> @_item.Note
        </MudText>
    }

    <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-1">
        <strong>录入者:</strong> @(_item.CreatedByUserName.Length > 0 ? _item.CreatedByUserName : "未知")
    </MudText>
    <MudText Typo="Typo.caption" Color="Color.Default">
        录入时间: @_item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
    </MudText>

    <div class="d-flex" style="gap:8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick='() => Navigation.NavigateTo("/browse")' Class="mt-4">
            返回浏览
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   OnClick="OpenDeleteDialogAsync" Class="mt-4"
                   Disabled="_isDeleting">
            @(_isDeleting ? "删除中..." : "删除物品")
        </MudButton>
    </div>
}

@code {
    private ItemDto? _item;
    private bool _loading = true;
    private bool _notFound;
    private bool _isDeleting;

    [Parameter] public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _item = await ItemService.GetByIdAsync(Id);
            _notFound = _item is null;
        }
        catch
        {
            _notFound = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatLocationPath(string? path, string? locationName, int? locationId)
    {
        if (!string.IsNullOrWhiteSpace(path))
        {
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length > 0)
                return string.Join(" → ", segments);
        }
        if (!string.IsNullOrWhiteSpace(locationName))
            return locationName;
        return locationId?.ToString() ?? "未分配";
    }

    private async Task OpenDeleteDialogAsync()
    {
        if (_item is null) return;

        var parameters = new DialogParameters
        {
            { "ItemName", _item.Name }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await ConfirmDeleteAsync();
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_item is null || _isDeleting) return;

        _isDeleting = true;
        StateHasChanged();

        try
        {
            var success = await ItemService.DeleteAsync(Id);
            if (success)
            {
                Navigation.NavigateTo("/browse");
            }
            else
            {
                _isDeleting = false;
            }
        }
        catch
        {
            _isDeleting = false;
        }
    }
}
