@page "/login"
@using BoxWise.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
            登录 BoxWise
        </MudText>

        @if (_loginStep == LoginStep.Credentials)
        {
            <EditForm Model="@_model" OnValidSubmit="HandleLogin">
                <MudTextField @bind-Value="_model.Username"
                              Label="用户名"
                              Required="true"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              FullWidth="true" />

                <MudTextField @bind-Value="_model.Password"
                              Label="密码"
                              InputType="InputType.Password"
                              Required="true"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              FullWidth="true" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                        @_error
                    </MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="@_isLoading">
                    @(_isLoading ? "登录中..." : "登录")
                </MudButton>
            </EditForm>

            <MudDivider Class="my-3" />

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Fingerprint"
                       Disabled="@_passkeyLoading"
                       @onclick="HandlePasskeyLogin">
                @(_passkeyLoading ? "验证中..." : "使用通行密钥登录")
            </MudButton>
        }
        else if (_loginStep == LoginStep.TwoFactor)
        {
            @if (_showRecoveryCode)
            {
                <MudText Typo="Typo.body2" Class="mb-4">
                    请输入您的恢复码
                </MudText>

                <MudTextField @bind-Value="_recoveryCode"
                              Label="恢复码"
                              Required="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              FullWidth="true"
                              HelperText="输入 8 位恢复码" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                        @_error
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="@(_isLoading || string.IsNullOrEmpty(_recoveryCode))"
                           @onclick="HandleRecoveryCodeVerify">
                    @(_isLoading ? "验证中..." : "使用恢复码登录")
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           FullWidth="true"
                           Class="mt-2"
                           @onclick="() => _showRecoveryCode = false">
                    返回验证码验证
                </MudButton>
            }
            else
            {
                @if (_allowedMethods.Count == 0)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                        无法获取可用的验证方式，请返回重新登录或联系管理员。
                    </MudAlert>
                }
                else
                {
                @if (_allowedMethods.Count > 1)
                {
                    <MudText Typo="Typo.body2" Class="mb-3">
                        请选择验证方式
                    </MudText>
                    <MudButtonGroup Class="mb-4" FullWidth="true">
                        @foreach (var method in _allowedMethods)
                        {
                            <MudButton Variant="@(_selectedMethod == method ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       @onclick="() => SelectMethod(method)">
                                @(method switch { "TOTP" => "生成器验证码", "Email" => "邮箱验证码", "WebAuthn" => "通行密钥", _ => method })
                            </MudButton>
                        }
                    </MudButtonGroup>
                }

                @if (_selectedMethod == "WebAuthn")
                {
                    <MudText Typo="Typo.body2" Class="mb-3">
                        使用已注册的通行密钥完成验证
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Fingerprint"
                               Disabled="@_isLoading"
                               @onclick="HandleWebAuthnVerify">
                        @(_isLoading ? "验证中..." : "使用通行密钥验证")
                    </MudButton>
                }
                else
                {
                    @if (_selectedMethod == "Email")
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                            验证码已发送至您的邮箱，请输入收到的 6 位验证码。
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="_totpCode"
                                  Label="@(_selectedMethod == "Email" ? "邮箱验证码" : "验证码")"
                                  Required="true"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-3"
                                  FullWidth="true"
                                  HelperText="输入 6 位验证码" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Disabled="@(_isLoading || string.IsNullOrEmpty(_totpCode))"
                               @onclick="HandleTwoFactorVerify">
                        @(_isLoading ? "验证中..." : "验证")
                    </MudButton>

                    @if (_selectedMethod == "Email")
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Class="mt-1"
                                   @onclick="ResendEmailCode">
                            重新发送验证码
                        </MudButton>
                    }
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                        @_error
                    </MudAlert>
                }

                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           FullWidth="true"
                           Class="mt-2"
                           @onclick="BackToCredentials">
                    返回
                </MudButton>

                <MudDivider Class="my-3" />

                @if (_hasRecoveryCodes)
                {
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           FullWidth="true"
                           @onclick="() => _showRecoveryCode = true">
                    使用恢复码登录
                </MudButton>
                }
                }
            }
        }
    </MudPaper>
</MudContainer>

@code {
    private LoginModel _model = new();
    private string? _error;
    private bool _isLoading;
    private LoginStep _loginStep = LoginStep.Credentials;
    private string _totpCode = string.Empty;
    private string _recoveryCode = string.Empty;
    private List<string> _allowedMethods = new();
    private string? _selectedMethod;
    private string? _emailToken;
    private bool _showRecoveryCode;
    private bool _hasRecoveryCodes;
    private bool _passkeyLoading;

    private async Task HandlePasskeyLogin()
    {
        _error = null;
        _passkeyLoading = true;

        try
        {
            var optionsJson = await AuthService.StartWebAuthnLoginAsync();
            if (optionsJson is null)
            {
                _error = "通行密钥功能暂不可用";
                return;
            }

            string assertionJson;
            try
            {
                assertionJson = await JS.InvokeAsync<string>("webauthn.getCredential", optionsJson);
            }
            catch (JSException)
            {
                _error = "未找到通行密钥，请使用密码登录";
                return;
            }

            var result = await AuthService.CompleteWebAuthnLoginAsync(assertionJson);
            if (result == LoginResult.Success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = "通行密钥验证失败";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _passkeyLoading = false;
        }
    }

    private async Task HandleLogin()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(_model.Username, _model.Password);

            if (result == LoginResult.Success)
            {
                Navigation.NavigateTo("/");
            }
            else if (result == LoginResult.RequiresTwoFactor)
            {
                _loginStep = LoginStep.TwoFactor;
                _model.Password = string.Empty; // 清除密码

                // 获取支持的 2FA 方法
                await LoadTwoFactorChallengeAsync();
            }
            else if (result == LoginResult.RequiresTwoFactorSetup || result == LoginResult.PasswordRequiresChange)
            {
                Navigation.NavigateTo("/settings");
            }
            else
            {
                _error = "用户名或密码错误";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadTwoFactorChallengeAsync()
    {
        try
        {
            var response = await AuthService.GetTwoFactorChallengeAsync();
            if (response?.AllowedMethods is not null)
            {
                _allowedMethods = response.AllowedMethods;
                _emailToken = response.Token;
                _hasRecoveryCodes = response.HasRecoveryCodes;
                _selectedMethod = _allowedMethods.FirstOrDefault();
            }
        }
        catch
        {
            _allowedMethods = new List<string>();
        }
    }

    private void SelectMethod(string method)
    {
        _selectedMethod = method;
        _totpCode = string.Empty;
        _error = null;
    }

    private async Task HandleWebAuthnVerify()
    {
        _error = null;
        _isLoading = true;

        try
        {
            // Step 1: 获取验证挑战
            var optionsJson = await AuthService.GetWebAuthnVerificationChallengeAsync();
            if (optionsJson is null)
            {
                _error = "无法获取通行密钥验证挑战，请检查网络";
                return;
            }

            // Step 2: 浏览器验证（指纹/面容/PIN）
            string assertionJson;
            try
            {
                assertionJson = await JS.InvokeAsync<string>("webauthn.getCredential", optionsJson);
            }
            catch (JSException ex) when (ex.Message.Contains("用户取消了操作"))
            {
                _error = "您已取消操作";
                return;
            }
            catch (JSException)
            {
                _error = "通行密钥验证失败，请确保已注册通行密钥";
                return;
            }

            // Step 3: 提交断言到服务器
            var result = await AuthService.VerifyWebAuthnAsync(assertionJson);
            if (result == LoginResult.Success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = "通行密钥验证失败";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleTwoFactorVerify()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.VerifyTwoFactorAsync(
                _totpCode,
                token: _selectedMethod == "Email" ? _emailToken : null,
                method: _selectedMethod);

            if (result == LoginResult.Success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = _selectedMethod == "Email"
                    ? "验证码无效或已过期，请重试或点击重新发送"
                    : "验证码无效，请重试";
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleRecoveryCodeVerify()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.VerifyRecoveryCodeDuringLoginAsync(_recoveryCode);

            if (result == LoginResult.Success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = "恢复码无效";
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResendEmailCode()
    {
        _error = null;
        try
        {
            var newToken = await AuthService.ResendTwoFactorChallengeCodeAsync();
            if (newToken is not null)
            {
                _emailToken = newToken;
                _error = null;
            }
        }
        catch
        {
            _error = "重新发送失败，请稍后重试";
        }
    }

    private void BackToCredentials()
    {
        _loginStep = LoginStep.Credentials;
        _error = null;
        _totpCode = string.Empty;
        _recoveryCode = string.Empty;
        _allowedMethods = new List<string>();
        _selectedMethod = null;
        _emailToken = null;
        _showRecoveryCode = false;
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private enum LoginStep
    {
        Credentials,
        TwoFactor
    }
}
