@page "/login"
@using BoxWise.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
            登录 BoxWise
        </MudText>

        <EditForm Model="@_model" OnValidSubmit="HandleLogin">
            <MudTextField @bind-Value="_model.Username"
                          Label="用户名"
                          Required="true"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          FullWidth="true" />

            <MudTextField @bind-Value="_model.Password"
                          Label="密码"
                          InputType="InputType.Password"
                          Required="true"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          FullWidth="true" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@_isLoading">
                @(_isLoading ? "登录中..." : "登录")
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private LoginModel _model = new();
    private string? _error;
    private bool _isLoading;

    private async Task HandleLogin()
    {
        _error = null;
        _isLoading = true;

        var result = await AuthService.LoginAsync(_model.Username, _model.Password);

        if (result == LoginResult.Success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = "用户名或密码错误";
        }

        _isLoading = false;
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
