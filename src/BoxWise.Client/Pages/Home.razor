@page "/"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization

@inject ItemService ItemService
@inject NavigationManager Navigation

<MudTextField @bind-Value="_query"
              @bind-Value:after="OnQueryChanged"
              Placeholder="搜索物品名称、备注或标签..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true"
              Variant="Variant.Outlined"
              Class="mb-4"
              FullWidth="true" />

@if (_loading)
{
    <div class="d-flex justify-center my-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_error)
{
    <div class="d-flex flex-column align-center justify-center my-8" style="color:#9E9E9E;">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-2">加载失败</MudText>
        <MudButton Variant="Variant.Outlined" OnClick="LoadAsync" Class="mt-2">重试</MudButton>
    </div>
}
else if (_items is { Count: 0 })
{
    <div class="d-flex flex-column align-center justify-center my-8" style="color:#9E9E9E;">
        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-2">
            @(string.IsNullOrEmpty(_query) ? "暂无物品" : "没有匹配的物品")
        </MudText>
        <MudText Typo="Typo.caption">
            @(string.IsNullOrEmpty(_query) ? "点击底部录入按钮添加第一个吧" : "试试其他关键词")
        </MudText>
    </div>
}
else if (_items is not null)
{
    <MudText Typo="Typo.caption" Class="mb-2">
        @(string.IsNullOrEmpty(_query) ? $"共 {_items.Count} 件物品" : $"找到 {_items.Count} 件物品")
    </MudText>
    <MudGrid>
        @foreach (var item in _items)
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <ItemCard Item="item" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private string _query = "";
    private List<ItemSummaryDto>? _items;
    private bool _loading = true;
    private bool _error;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task OnQueryChanged()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        try
        {
            await Task.Delay(300, ct);

            if (string.IsNullOrWhiteSpace(_query))
            {
                _error = false;
                _loading = true;
                StateHasChanged();
                _items = await ItemService.GetFilteredAsync(null, null, null, ct) ?? [];
                if (!ct.IsCancellationRequested)
                {
                    _loading = false;
                    StateHasChanged();
                }
                return;
            }

            _loading = true;
            StateHasChanged();

            var results = await ItemService.SearchAsync(_query, ct);
            if (!ct.IsCancellationRequested)
            {
                _error = false;
                _items = results ?? [];
                _loading = false;
                StateHasChanged();
            }
            else
            {
                _loading = false;
            }
        }
        catch (TaskCanceledException)
        {
            _loading = false;
            StateHasChanged();
        }
        catch
        {
            if (!ct.IsCancellationRequested)
            {
                _error = true;
                _loading = false;
            }
            else
            {
                _loading = false;
            }
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }

    private async Task LoadAsync()
    {
        _error = false;
        _loading = true;
        StateHasChanged();

        try
        {
            _items = await ItemService.GetFilteredAsync(null, null, null, CancellationToken.None) ?? [];
        }
        catch
        {
            _error = true;
            _items = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
