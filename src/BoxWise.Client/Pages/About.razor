@page "/about"
@attribute [Authorize]
@using System.Reflection
@using System.Runtime.InteropServices

<MudText Typo="Typo.h5" Class="mb-4">关于</MudText>

<div class="bw-about-section mb-4">
    <img src="logo.svg" alt="BoxWise Logo" class="bw-about-logo mb-3" />
    <MudText Typo="Typo.h6" Style="font-weight:600;">箱知 BoxWise</MudText>
    <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-2">家庭物品管理，一目了然</MudText>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">v@(_version)</MudChip>
</div>

<MudText Typo="Typo.subtitle2" Class="mb-2">运行环境</MudText>
<MudPaper Class="pa-3 mb-4 bw-about-paper" Elevation="0">
    <dl class="bw-dl">
        <dt>.NET 运行时</dt>
        <dd>@_framework</dd>
        <dt>操作系统</dt>
        <dd>@RuntimeInformation.OSDescription</dd>
        <dt>架构</dt>
        <dd>@RuntimeInformation.OSArchitecture</dd>
        <dt>数据库</dt>
        <dd>SQLite (EF Core)</dd>
    </dl>
</MudPaper>

<MudText Typo="Typo.subtitle2" Class="mb-2">第三方依赖与许可</MudText>
<MudPaper Class="pa-3 mb-4 bw-about-paper" Elevation="0">
    <div class="bw-license-list">
        @foreach (var lib in _libraries)
        {
            <div class="bw-license-row">
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body2" Style="font-weight:500;">@lib.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">@lib.Version</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(lib.License is "MIT" ? Color.Success : Color.Info)">@lib.License</MudChip>
            </div>
            @if (lib != _libraries.Last())
            {
                <MudDivider Class="my-1" />
            }
        }
    </div>
</MudPaper>

<MudText Typo="Typo.subtitle2" Class="mb-2">图标归属</MudText>
<MudPaper Class="pa-3 mb-4 bw-about-paper" Elevation="0">
    <div class="d-flex align-center">
        <div class="flex-grow-1">
            <MudText Typo="Typo.body2">Noto Emoji</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">Google Fonts</MudText>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">SIL OFL 1.1</MudChip>
    </div>
    <MudDivider Class="my-2" />
    <MudLink Href="https://github.com/googlefonts/noto-emoji" Target="_blank" Typo="Typo.caption">github.com/googlefonts/noto-emoji</MudLink>
</MudPaper>

<MudText Typo="Typo.subtitle2" Class="mb-2">开源</MudText>
<MudPaper Class="pa-3 mb-4 bw-about-paper" Elevation="0">
    <div class="d-flex align-center mb-2">
        <div class="flex-grow-1">
            <MudText Typo="Typo.body2" Style="font-weight:500;">BoxWise</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">GNU General Public License v3.0</MudText>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">GPL-3.0</MudChip>
    </div>
    <MudLink Href="https://github.com/elvisw/BoxWise" Target="_blank" Typo="Typo.caption">github.com/elvisw/BoxWise</MudLink>
</MudPaper>

@code {
    private string _version = "";
    private string _framework = "";

    private record struct LibInfo(string Name, string Version, string License);

    private static readonly List<LibInfo> _libraries = new()
    {
        new("MudBlazor", "9.4.0", "MIT"),
        new("SkiaSharp", "3.119.2", "MIT"),
        new("SixLabors.ImageSharp", "3.1.7", "Apache-2.0"),
        new("ASP.NET Core", "10.0.8", "MIT"),
        new("Entity Framework Core", "10.0.8", "MIT"),
        new("xunit", "2.9.3", "MIT"),
        new("coverlet", "6.0.4", "MIT"),
    };

    protected override void OnInitialized()
    {
        var infoVersion = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        _version = infoVersion ?? "1.0.0";
        _framework = RuntimeInformation.FrameworkDescription;
    }
}
