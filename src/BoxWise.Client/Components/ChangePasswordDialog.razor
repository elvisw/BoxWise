@namespace BoxWise.Client.Components
@using MudBlazor
@inject AuthService AuthService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">修改密码</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Color="Color.Error" Class="mb-2">@_error</MudText>
        }
        @if (_saved)
        {
            <MudText Color="Color.Success" Class="mb-2">密码已更新</MudText>
        }
        <MudTextField @bind-Value="_currentPassword" Label="当前密码"
                      Variant="Variant.Outlined" Class="mb-2"
                      InputType="InputType.Password" Disabled="@_saving" />
        <MudTextField @bind-Value="_newPassword" Label="新密码"
                      Variant="Variant.Outlined" Class="mb-2"
                      InputType="InputType.Password" Disabled="@_saving"
                      HelperText="至少 4 个字符" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="SaveAsync" Color="Color.Primary"
                   Variant="Variant.Filled" Disabled="@(_saving || string.IsNullOrEmpty(_currentPassword) || string.IsNullOrEmpty(_newPassword) || _newPassword.Length < 4)">保存</MudButton>
        <MudButton OnClick="Cancel">取消</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _currentPassword = "";
    private string _newPassword = "";
    private string? _error;
    private bool _saving;
    private bool _saved;

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        _saved = false;

        var (success, error) = await AuthService.ChangePasswordAsync(_currentPassword, _newPassword);
        _saving = false;

        if (success)
        {
            MudDialog.Close();
        }
        else
        {
            _error = error;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
