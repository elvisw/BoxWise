@using BoxWise.Shared.Dtos
@inject LocationService LocationService

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}
else if (_error)
{
    <MudText Typo="Typo.caption" Color="Color.Error">加载位置失败</MudText>
}
else if (!_hasData)
{
    <MudText Typo="Typo.caption" Color="Color.Default">暂无位置，请先在管理后台创建</MudText>
}
else
{
    <MudTreeView T="LocationDto" Items="TreeItems"
                 SelectedValue="_selectedValue"
                 SelectedValueChanged="OnSelectedValueChanged">
        <ItemTemplate Context="item">
            <MudTreeViewItem Value="@item.Value" Items="@item.Children">
                <BodyContent>
                    <MudText>@(item.Value?.Name ?? "")</MudText>
                </BodyContent>
            </MudTreeViewItem>
        </ItemTemplate>
    </MudTreeView>
}

@code {
    [Parameter] public int? SelectedLocationId { get; set; }
    [Parameter] public EventCallback<int?> SelectedLocationIdChanged { get; set; }

    private List<TreeItemData<LocationDto>> TreeItems = [];
    private LocationDto? _selectedValue;
    private bool _hasData;
    private bool _loading = true;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            var locations = await LocationService.GetAllAsync();
            _hasData = locations.Count > 0;
            TreeItems = BuildTree(locations);
            InitSelectedValue(locations);
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (SelectedLocationId.HasValue && TreeItems.Count > 0
            && (_selectedValue is null || _selectedValue.Id != SelectedLocationId.Value))
        {
            _selectedValue = FindLocationById(TreeItems, SelectedLocationId.Value);
        }
    }

    private static LocationDto? FindLocationById(List<TreeItemData<LocationDto>> items, int id)
    {
        foreach (var item in items)
        {
            if (item.Value?.Id == id) return item.Value;
            var found = FindLocationById(item.Children?.OfType<TreeItemData<LocationDto>>().ToList() ?? [], id);
            if (found is not null) return found;
        }
        return null;
    }

    private void InitSelectedValue(List<LocationDto> locations)
    {
        if (SelectedLocationId.HasValue)
        {
            _selectedValue = locations.FirstOrDefault(l => l.Id == SelectedLocationId.Value);
        }
    }

    private async Task OnSelectedValueChanged(LocationDto? value)
    {
        _selectedValue = value;
        SelectedLocationId = value?.Id;
        await SelectedLocationIdChanged.InvokeAsync(SelectedLocationId);
    }

    private static List<TreeItemData<LocationDto>> BuildTree(List<LocationDto> locations)
    {
        var byParent = locations
            .GroupBy(l => l.ParentId ?? 0)
            .ToDictionary(g => g.Key, g => g.OrderBy(l => l.SortOrder).ThenBy(l => l.Name).ToList());

        return BuildLevel(0);

        List<TreeItemData<LocationDto>> BuildLevel(int parentId)
        {
            if (!byParent.TryGetValue(parentId, out var children))
                return [];

            return children.Select(l => new TreeItemData<LocationDto>
            {
                Value = l,
                Text = l.Name,
                Children = BuildLevel(l.Id)
            }).ToList();
        }
    }
}
