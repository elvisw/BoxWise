@namespace BoxWise.Client.Components
@using BoxWise.Shared.Dtos
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-2" />
}
else if (_authError)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" Dense="true">
        登录已过期，请重新登录
    </MudAlert>
}
else if (_credentials.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Default" Class="my-4" Align="Align.Center">
        暂无通行密钥，注册后可在此管理
    </MudText>
}
else
{
    @foreach (var cred in _credentials)
    {
        <MudPaper Class="pa-3 mb-2" Elevation="1" Outlined="true">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.body2" Style="font-weight: 500;">
                        <MudIcon Icon="@Icons.Material.Filled.Usb" Size="Size.Small" Class="mr-2" Color="Color.Default" />
                        @cred.DeviceName
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="ml-6">
                        注册于 @cred.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </MudText>
                </div>
                @if (_confirmingId == cred.Id)
                {
                    <div class="d-flex align-center" style="gap: 4px;">
                        <MudText Typo="Typo.caption" Color="Color.Error">确认删除？</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@_isDeleting"
                                       OnClick="@(() => ConfirmDeleteAsync(cred))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="@(() => _confirmingId = null)" />
                    </div>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   Disabled="@_isDeleting"
                                   OnClick="@(() => _confirmingId = cred.Id)" />
                }
            </div>
        </MudPaper>
    }
}

@code {
    private List<WebAuthnCredentialDto> _credentials = new();
    private int? _confirmingId;
    private bool _isLoading = true;
    private bool _isDeleting;
    private bool _authError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCredentialsAsync();
    }

    public async Task LoadCredentialsAsync()
    {
        _isLoading = true;
        _authError = false;
        StateHasChanged();

        try
        {
            _credentials = await AuthService.GetWebAuthnCredentialsAsync();
        }
        catch (InvalidOperationException)
        {
            _authError = true;
            _credentials = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ConfirmDeleteAsync(WebAuthnCredentialDto credential)
    {
        _confirmingId = null;
        _isDeleting = true;
        var backup = _credentials.ToList();
        _credentials.Remove(credential);
        StateHasChanged();

        try
        {
            var success = await AuthService.DeleteWebAuthnCredentialAsync(credential.Id);
            if (!success)
            {
                Snackbar.Add("凭证不存在，列表已刷新", Severity.Warning);
                await LoadCredentialsAsync();
                return;
            }
            Snackbar.Add($"已移除 {credential.DeviceName} 通行密钥", Severity.Success);
        }
        catch (InvalidOperationException)
        {
            _credentials = backup;
            Snackbar.Add("登录已过期，请重新登录", Severity.Error);
        }
        catch
        {
            _credentials = backup;
            Snackbar.Add("删除失败，请检查网络后重试", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
