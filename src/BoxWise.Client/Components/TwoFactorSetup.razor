@namespace BoxWise.Client.Components
@using BoxWise.Shared.Dtos
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">设置双因素认证</MudText>
    </TitleContent>
    <DialogContent>
        @if (_setupStep == SetupStep.ChooseMethod)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                选择一个双因素认证方式以增强账户安全性。
            </MudText>

            <MudPaper Class="pa-4 mb-2" Elevation="1" Outlined="true">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Smartphone" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1" Style="font-weight:500;">TOTP 验证器</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            使用 Google Authenticator、Authy 等应用
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@_isLoading" @onclick="StartTotpSetup">
                        @(_isLoading ? "处理中..." : "设置")
                    </MudButton>
                </div>
            </MudPaper>

            @if (_emailAvailable)
            {
                <MudPaper Class="pa-4 mb-2" Elevation="1" Outlined="true">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body1" Style="font-weight:500;">邮箱验证码</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                每次登录时向您的邮箱发送验证码
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@_isLoading" @onclick="StartEmailSetup">
                            @(_isLoading ? "处理中..." : "设置")
                        </MudButton>
                    </div>
                </MudPaper>
            }
        }
        else if (_setupStep == SetupStep.VerifyPassword)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                请先输入当前密码以验证身份。
            </MudText>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }

            <MudTextField @bind-Value="_password"
                          Label="当前密码"
                          InputType="InputType.Password"
                          Required="true"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_isLoading || string.IsNullOrEmpty(_password))"
                       @onclick="VerifyPassword">
                @(_isLoading ? "验证中..." : "验证密码")
            </MudButton>
        }
        else if (_setupStep == SetupStep.SetupTotp)
        {
            <TotpSetup SessionToken="@_sessionToken"
                       OnSetupComplete="OnTotpSetupComplete"
                       OnBack="Cancel" />
        }
        else if (_setupStep == SetupStep.SetupEmail)
        {
            <EmailTwoFactorSetup SessionToken="@_sessionToken"
                                 OnSetupComplete="OnEmailSetupComplete"
                                 OnBack="Cancel" />
        }
        else if (_setupStep == SetupStep.Complete)
        {
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-2">
                双因素认证已成功启用！
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Default" Class="mb-3">
                下次登录时，您需要同时输入密码和验证码。
            </MudText>

            @if (_recoveryCodes?.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                    <MudText Typo="Typo.body2">
                        请立即保存以下恢复码。如果无法访问 2FA 设备，您可以使用恢复码登录。
                    </MudText>
                </MudAlert>

                <div class="d-flex flex-column align-center" style="gap: 4px;">
                    @if (_recoveryCodes is not null)
                    {
                        @foreach (var rc in _recoveryCodes)
                        {
                            var capturedCode = rc;
                            <MudPaper Class="pa-2" Elevation="0" Outlined="true" Style="width: 100%; max-width: 320px;">
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2"
                                             Style="font-family: monospace; font-size: 1.1rem; letter-spacing: 2px;"
                                             Color="Color.Secondary">
                                        @rc
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => CopyCode(capturedCode))" />
                                </div>
                            </MudPaper>
                        }
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_setupStep is SetupStep.ChooseMethod or SetupStep.VerifyPassword)
        {
            <MudButton OnClick="Cancel">取消</MudButton>
        }
        else if (_setupStep == SetupStep.Complete)
        {
            <MudButton OnClick="CloseRecoveryDialog" Color="Color.Primary" Variant="Variant.Filled">
                完成
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private SetupStep _setupStep = SetupStep.ChooseMethod;
    private string? _error;
    private bool _isLoading;
    private string _password = string.Empty;
    private string? _sessionToken;
    private bool _emailAvailable;
    private List<string>? _recoveryCodes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await AuthService.GetTwoFactorStatusAsync();
            _emailAvailable = status?.AvailableMethods?.Contains("Email") == true;
        }
        catch
        {
            _emailAvailable = false;
        }
    }

    private async Task StartTotpSetup()
    {
        _setupStep = SetupStep.VerifyPassword;
        _error = null;
        _selectedMethod = "TOTP";
        StateHasChanged();
    }

    private async Task StartEmailSetup()
    {
        _setupStep = SetupStep.VerifyPassword;
        _error = null;
        _selectedMethod = "Email";
        StateHasChanged();
    }

    private async Task StartWebAuthnSetup()
    {
        _setupStep = SetupStep.VerifyPassword;
        _error = null;
        _selectedMethod = "WebAuthn";
        StateHasChanged();
    }

    private string _selectedMethod = "TOTP";

    private async Task VerifyPassword()
    {
        _error = null;
        _isLoading = true;

        try
        {
            _sessionToken = await AuthService.ReAuthenticateAsync(_password);
            _setupStep = _selectedMethod switch
            {
                "Email" => SetupStep.SetupEmail,
                "WebAuthn" => SetupStep.SetupWebAuthn,
                _ => SetupStep.SetupTotp
            };
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnTotpSetupComplete()
    {
        _recoveryCodes = AuthService.GetLastRecoveryCodes();
        _setupStep = SetupStep.Complete;
        StateHasChanged();
    }

    private void OnEmailSetupComplete(List<string> codes)
    {
        _recoveryCodes = codes;
        _setupStep = SetupStep.Complete;
        StateHasChanged();
    }

    private void OnWebAuthnSetupComplete()
    {
        _recoveryCodes = AuthService.GetLastRecoveryCodes();
        _setupStep = SetupStep.Complete;
        StateHasChanged();
    }

    private async Task CopyCode(string code)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Snackbar.Add("已复制到剪贴板", Severity.Success);
        }
        catch
        {
            Snackbar.Add("复制失败，请手动复制", Severity.Warning);
        }
    }

    private void CloseRecoveryDialog()
    {
        AuthService.ClearLastRecoveryCodes();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private enum SetupStep
    {
        ChooseMethod,
        VerifyPassword,
        SetupTotp,
        SetupEmail,
        SetupWebAuthn,
        Complete
    }
}
