@namespace BoxWise.Client.Components
@using BoxWise.Shared.Dtos
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">设置双因素认证</MudText>
    </TitleContent>
    <DialogContent>
        @if (_setupStep == SetupStep.ChooseMethod)
        {
            @if (_twoFactorEnabled)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
                    双因素认证已启用
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-4">
                    选择一个双因素认证方式以增强账户安全性。
                </MudText>
            }

            <MudPaper Class="pa-4 mb-2" Elevation="1" Outlined="true">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Smartphone" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1" Style="font-weight:500;">TOTP 验证器</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            使用 Google Authenticator、Authy 等应用
                        </MudText>
                    </div>
                    @if (_configuredMethods.Contains("TOTP"))
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                            已启用
                        </MudChip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@_isLoading" @onclick="StartTotpSetup">
                            @(_isLoading ? "处理中..." : "设置")
                        </MudButton>
                    }
                </div>
            </MudPaper>

            @if (_emailAvailable)
            {
                <MudPaper Class="pa-4 mb-2" Elevation="1" Outlined="true">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Medium" Class="mr-3" Color="Color.Primary" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body1" Style="font-weight:500;">邮箱验证码</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                每次登录时向您的邮箱发送验证码
                            </MudText>
                        </div>
                        @if (_configuredMethods.Contains("Email"))
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                已启用
                            </MudChip>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       Disabled="@_isLoading" @onclick="StartEmailSetup">
                                @(_isLoading ? "处理中..." : "设置")
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-4 mb-2" Elevation="1" Outlined="true">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Medium" Class="mr-3" Color="Color.Default" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body1" Style="font-weight:500;" Color="Color.Default">邮箱验证码</MudText>
                            @if (_configuredMethods.Contains("Email"))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">
                                    SMTP 暂时不可用，登录时可能无法使用邮箱验证
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Default">
                                    SMTP 未配置，请联系管理员
                                </MudText>
                            }
                        </div>
                        @if (_configuredMethods.Contains("Email"))
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                已启用
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Block">
                                不可用
                            </MudChip>
                        }
                    </div>
                </MudPaper>
            }
        }
        else if (_setupStep == SetupStep.VerifyPassword)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                请先输入当前密码以验证身份。
            </MudText>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }

            <MudTextField @bind-Value="_password"
                          Label="当前密码"
                          InputType="InputType.Password"
                          Required="true"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_isLoading || string.IsNullOrEmpty(_password))"
                       @onclick="VerifyPassword">
                @(_isLoading ? "验证中..." : "验证密码")
            </MudButton>
        }
        else if (_setupStep == SetupStep.SetupTotp)
        {
            <TotpSetup SessionToken="@_sessionToken"
                       OnSetupComplete="OnTotpSetupComplete"
                       OnBack="Cancel" />
        }
        else if (_setupStep == SetupStep.SetupEmail)
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }

            @if (!_emailCodeSent)
            {
                <MudText Typo="Typo.body2" Class="mb-4">
                    验证码将发送到您账户绑定的邮箱。
                </MudText>

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true"
                           Disabled="@(_isLoading)"
                           @onclick="SendEmailCodeAsync">
                    @(_isLoading ? "发送中..." : "发送验证码到邮箱")
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    验证码已发送到您的邮箱，请输入 6 位验证码。
                </MudText>

                <MudTextField @bind-Value="_emailCode"
                              Label="验证码"
                              Required="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              HelperText="输入 6 位验证码" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Class="mt-3"
                           Disabled="@(_isLoading || string.IsNullOrEmpty(_emailCode) || _emailCode.Length < 6)"
                           @onclick="VerifyEmailCodeAsync">
                    @(_isLoading ? "验证中..." : "确认并启用")
                </MudButton>
            }
        }
        else if (_setupStep == SetupStep.Complete)
        {
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-2">
                双因素认证已成功启用！
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Default" Class="mb-3">
                下次登录时，您需要同时输入密码和验证码。
            </MudText>

            @if (_recoveryCodes?.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                    <MudText Typo="Typo.body2">
                        请立即保存以下恢复码。如果无法访问 2FA 设备，您可以使用恢复码登录。
                    </MudText>
                </MudAlert>

                <div class="d-flex flex-column align-center" style="gap: 4px;">
                    @if (_recoveryCodes is not null)
                    {
                        @foreach (var rc in _recoveryCodes)
                        {
                            var capturedCode = rc;
                            <MudPaper Class="pa-2" Elevation="0" Outlined="true" Style="width: 100%; max-width: 320px;">
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2"
                                             Style="font-family: monospace; font-size: 1.1rem; letter-spacing: 2px;"
                                             Color="Color.Secondary">
                                        @rc
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => CopyCode(capturedCode))" />
                                </div>
                            </MudPaper>
                        }
                    }
                </div>

                <div class="d-flex justify-center mt-4" style="gap: 8px;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ContentCopy"
                               Disabled="@_isLoading"
                               OnClick="CopyAllCodes">
                        复制全部
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@_isLoading"
                               OnClick="DownloadCodes">
                        下载
                    </MudButton>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_setupStep is SetupStep.ChooseMethod or SetupStep.VerifyPassword)
        {
            <MudButton OnClick="Cancel">取消</MudButton>
        }
        else if (_setupStep == SetupStep.Complete)
        {
            <MudButton OnClick="CloseRecoveryDialog" Color="Color.Primary" Variant="Variant.Filled">
                完成
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private SetupStep _setupStep = SetupStep.ChooseMethod;
    private string? _error;
    private bool _isLoading;
    private string _password = string.Empty;
    private string? _sessionToken;
    private bool _emailAvailable;
    private List<string> _configuredMethods = new();
    private bool _twoFactorEnabled;
    private List<string>? _recoveryCodes;

    // Email setup fields
    private string _emailCode = string.Empty;
    private string? _emailToken;
    private bool _emailCodeSent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await AuthService.GetTwoFactorStatusAsync();
            _emailAvailable = status?.AvailableMethods?.Contains("Email") == true;
            _configuredMethods = status?.ConfiguredMethods ?? new List<string>();
            _twoFactorEnabled = status?.TwoFactorEnabled ?? false;
        }
        catch
        {
            _emailAvailable = false;
            _configuredMethods = new();
            _twoFactorEnabled = false;
        }
    }

    private async Task StartTotpSetup()
    {
        _setupStep = SetupStep.VerifyPassword;
        _error = null;
        _selectedMethod = "TOTP";
        StateHasChanged();
    }

    private async Task StartEmailSetup()
    {
        _setupStep = SetupStep.VerifyPassword;
        _error = null;
        _selectedMethod = "Email";
        StateHasChanged();
    }

    private string _selectedMethod = "TOTP";

    private async Task VerifyPassword()
    {
        _error = null;
        _isLoading = true;

        try
        {
            _sessionToken = await AuthService.ReAuthenticateAsync(_password);
            _setupStep = _selectedMethod switch
            {
                "Email" => SetupStep.SetupEmail,
                _ => SetupStep.SetupTotp
            };
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnTotpSetupComplete()
    {
        _recoveryCodes = AuthService.GetLastRecoveryCodes();
        _setupStep = SetupStep.Complete;
        StateHasChanged();
    }

    private async Task SendEmailCodeAsync()
    {
        _error = null;
        _isLoading = true;

        try
        {
            _emailToken = await AuthService.SetupEmailTwoFactorAsync(_sessionToken!);
            _emailCodeSent = true;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyEmailCodeAsync()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var (success, recoveryCodes) = await AuthService.VerifyEmailTwoFactorAsync(_sessionToken!, _emailCode, _emailToken ?? "");
            if (success)
            {
                _recoveryCodes = recoveryCodes;
                _setupStep = SetupStep.Complete;
                StateHasChanged();
            }
            else
            {
                _error = "验证码无效，请确认输入的验证码正确";
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CopyCode(string code)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Snackbar.Add("已复制到剪贴板", Severity.Success);
        }
        catch
        {
            Snackbar.Add("复制失败，请手动复制", Severity.Warning);
        }
    }

    private async Task CopyAllCodes()
    {
        if (_recoveryCodes is not { Count: > 0 })
        {
            Snackbar.Add("没有可复制的恢复码", Severity.Warning);
            return;
        }

        try
        {
            var allCodes = string.Join(Environment.NewLine, _recoveryCodes);
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", allCodes);
            Snackbar.Add($"已复制 {_recoveryCodes.Count} 个恢复码到剪贴板", Severity.Success);
        }
        catch
        {
            Snackbar.Add("复制失败，请手动复制", Severity.Warning);
        }
    }

    private async Task DownloadCodes()
    {
        if (_recoveryCodes is not { Count: > 0 })
        {
            Snackbar.Add("没有可下载的恢复码", Severity.Warning);
            return;
        }

        try
        {
            var content = string.Join(Environment.NewLine, _recoveryCodes);
            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            var base64 = Convert.ToBase64String(bytes);
            await JsRuntime.InvokeVoidAsync("downloadFile", "boxwise-recovery-codes.txt", "text/plain", base64);
            Snackbar.Add("恢复码已下载", Severity.Success);
        }
        catch
        {
            Snackbar.Add("下载失败，请手动复制恢复码", Severity.Warning);
        }
    }

    private void CloseRecoveryDialog()
    {
        AuthService.ClearLastRecoveryCodes();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private enum SetupStep
    {
        ChooseMethod,
        VerifyPassword,
        SetupTotp,
        SetupEmail,
        Complete
    }
}
