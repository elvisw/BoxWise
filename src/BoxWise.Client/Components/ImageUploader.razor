@using Microsoft.AspNetCore.Components.Forms

<InputFile OnChange="OnFileSelected" accept="image/*" />
@if (_previewUrl is not null)
{
    <MudPaper Elevation="2" Class="my-3 pa-2">
        <img src="@_previewUrl" style="max-width:100%;max-height:300px" />
    </MudPaper>
}

@code {
    [Parameter] public EventCallback<IBrowserFile> OnFileUploaded { get; set; }

    private string? _previewUrl;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.GetMultipleFiles(1).FirstOrDefault();
        if (file is null) return;

        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new System.IO.MemoryStream();
        await stream.CopyToAsync(ms);
        _previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";

        await OnFileUploaded.InvokeAsync(file);
    }
}
