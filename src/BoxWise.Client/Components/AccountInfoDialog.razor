@namespace BoxWise.Client.Components
@using BoxWise.Shared.Dtos
@using MudBlazor
@inject AuthService AuthService
@inject AppState AppState

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_hasEmail ? "账户信息" : "设置邮箱")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_step == Step.PasswordAuth)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                请先输入当前密码以验证身份。
            </MudText>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }
            <MudTextField @bind-Value="_password"
                          Label="当前密码"
                          InputType="InputType.Password"
                          Required="true"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Disabled="@_loading"
                          FullWidth="true" />
        }
        else if (_step == Step.TwoFactorVerify)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                请选择以下任一方式完成身份验证。
            </MudText>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }

            @if (_twoFactorStatus?.ConfiguredMethods.Contains("TOTP") == true)
            {
                <MudText Typo="Typo.body2" Class="mb-1">TOTP 验证码</MudText>
                <div class="d-flex align-center mb-3" style="gap: 8px;">
                    <MudTextField @bind-Value="_totpCode"
                                  Label="验证码"
                                  Required="true"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  HelperText="输入验证器应用中的 6 位验证码" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(_loading || string.IsNullOrEmpty(_totpCode) || _totpCode.Length < 6)"
                               @onclick="VerifyTOTPAsync"
                               Class="flex-shrink-0">
                        @(_loading ? "..." : "验证")
                    </MudButton>
                </div>
            }

            @if (_twoFactorStatus?.ConfiguredMethods.Contains("Email") == true)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2" Class="mb-1 mt-2">邮箱验证码</MudText>

                @if (!_emailCodeSent)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@_loading"
                               @onclick="SendEmailChallengeAsync">
                        @(_loading ? "发送中..." : "发送验证码")
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mb-2">
                        验证码已发送至您绑定的邮箱。
                    </MudText>
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudTextField @bind-Value="_emailCode"
                                      Label="验证码"
                                      Required="true"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      HelperText="输入邮箱中的 6 位验证码" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(_loading || string.IsNullOrEmpty(_emailCode) || _emailCode.Length < 6)"
                                   @onclick="VerifyEmail2FAAsync"
                                   Class="flex-shrink-0">
                            @(_loading ? "..." : "验证")
                        </MudButton>
                    </div>
                }
            }

            @if (_twoFactorStatus?.HasRecoveryCodes == true)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2" Class="mb-1 mt-2">恢复码</MudText>
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudTextField @bind-Value="_recoveryCode"
                                  Label="恢复码"
                                  Required="true"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               Disabled="@(_loading || string.IsNullOrEmpty(_recoveryCode))"
                               @onclick="VerifyRecoveryCodeAsync"
                               Class="flex-shrink-0">
                        @(_loading ? "..." : "验证")
                    </MudButton>
                </div>
            }
        }
        else if (_step == Step.VerifyEmail)
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    @_error
                </MudAlert>
            }

            @if (_hasEmail)
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    当前邮箱：<strong>@_originalEmail</strong>
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    输入新邮箱地址以接收验证码。
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    输入您的邮箱地址并获取验证码。
                </MudText>
            }

            <MudTextField @bind-Value="_newEmail"
                          Label="新邮箱地址"
                          InputType="InputType.Email"
                          Required="true"
                          Immediate="true"
                          DebounceInterval="3000"
                          Variant="Variant.Outlined"
                          Disabled="@(_codeSent || _loading)"
                          FullWidth="true"
                          Validation="@(new Func<string, string?>(ValidateEmail))" />

            @if (!_codeSent)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-3"
                           Disabled="@(_loading || string.IsNullOrEmpty(_newEmail))"
                           @onclick="SendCodeAsync">
                    @(_loading ? "发送中..." : "发送验证码")
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-2 mt-3">
                    验证码已发送至 @_newEmail，请输入您收到的 6 位验证码。
                </MudText>

                <MudTextField @bind-Value="_code"
                              Label="验证码"
                              Required="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              HelperText="输入 6 位验证码" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-3"
                           Disabled="@(_loading || string.IsNullOrEmpty(_code) || _code.Length < 6)"
                           @onclick="VerifyCodeAsync">
                    @(_loading ? "验证中..." : "确认验证码")
                </MudButton>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_step == Step.PasswordAuth)
        {
            <MudButton OnClick="Cancel">取消</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(_loading || string.IsNullOrEmpty(_password))"
                       @onclick="AuthenticateAsync">
                @(_loading ? "验证中..." : "验证密码")
            </MudButton>
        }
        else if (_step == Step.TwoFactorVerify)
        {
            <MudButton OnClick="BackToPasswordAuth" Disabled="@_loading">返回</MudButton>
        }
        else if (_step == Step.VerifyEmail)
        {
            <MudButton OnClick="BackToPasswordAuth" Disabled="@_loading">返回</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private Step _step = Step.PasswordAuth;
    private string _password = string.Empty;
    private string _newEmail = string.Empty;
    private string _code = string.Empty;
    private string? _sessionToken;
    private string? _modifySessionToken;
    private string? _verificationToken;
    private string? _error;
    private bool _loading;

    private string _originalName = "";
    private string _originalEmail = "";
    private bool _hasEmail;

    // 2FA 验证状态
    private TwoFactorStatusDto? _twoFactorStatus;
    private string _totpCode = string.Empty;
    private string _emailCode = string.Empty;
    private string _recoveryCode = string.Empty;
    private string? _emailChallengeToken;
    private bool _emailCodeSent;

    protected override void OnInitialized()
    {
        _originalName = AppState.CurrentUserName ?? "";
        _originalEmail = AppState.CurrentUserEmail ?? "";
        _hasEmail = !string.IsNullOrWhiteSpace(_originalEmail);
        _newEmail = _originalEmail; // Pre-fill with current email if exists
    }

    private async Task AuthenticateAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            _sessionToken = await AuthService.ReAuthenticateAsync(_password);

            // 检查 2FA 状态以确定是否需要附加验证
            var status = await AuthService.GetTwoFactorStatusAsync();
            _twoFactorStatus = status;

            if (status?.TwoFactorEnabled == true)
            {
                // 用户已启用 2FA — 需要先完成 2FA 验证
                _step = Step.TwoFactorVerify;
            }
            else
            {
                // 未启用 2FA — 直接进入邮箱修改
                _step = Step.VerifyEmail;
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // ===== 2FA 验证方法 =====

    /// <summary>
    /// 发送邮箱 2FA 验证码。
    /// </summary>
    private async Task SendEmailChallengeAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            _emailChallengeToken = await AuthService.SendModifyEmailChallengeAsync(_sessionToken!);
            _emailCodeSent = true;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// TOTP 2FA 验证。
    /// </summary>
    private async Task VerifyTOTPAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            _modifySessionToken = await AuthService.AuthenticateForModifyAsync(_totpCode, "TOTP", null);
            if (_modifySessionToken is null)
            {
                _error = "验证失败，请重试";
                return;
            }

            _step = Step.VerifyEmail;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 邮箱 2FA 验证。
    /// </summary>
    private async Task VerifyEmail2FAAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            _modifySessionToken = await AuthService.AuthenticateForModifyAsync(_emailCode, "Email", _emailChallengeToken);
            if (_modifySessionToken is null)
            {
                _error = "验证失败，请重试";
                return;
            }

            _step = Step.VerifyEmail;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 恢复码 2FA 验证。
    /// </summary>
    private async Task VerifyRecoveryCodeAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            _modifySessionToken = await AuthService.AuthenticateForModifyAsync(_recoveryCode, "RecoveryCode", null);
            if (_modifySessionToken is null)
            {
                _error = "验证失败，请重试";
                return;
            }

            _step = Step.VerifyEmail;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SendCodeAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            var tokenToUse = _modifySessionToken ?? _sessionToken;
            _verificationToken = await AuthService.SendEmailVerificationCodeAsync(tokenToUse!, _newEmail);
            _codeSent = true;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            // 如果 session token 过期，回退到 Step 1
            if (ex.Message.Contains("无效") || ex.Message.Contains("过期") || ex.Message.Contains("令牌"))
            {
                _error = "操作超时，请重新验证";
                _step = Step.PasswordAuth;
                _sessionToken = null;
                _modifySessionToken = null;
                _password = string.Empty;
            }
            else
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private bool _codeSent;

    private async Task VerifyCodeAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            var (operationToken, verifiedEmail) = await AuthService.VerifyEmailCodeAsync(_code, _verificationToken!);
            if (operationToken is null || verifiedEmail is null)
            {
                _error = "验证失败，请重试";
                return;
            }

            // 使用 operation token 更新邮箱
            var (success, error) = await AuthService.UpdateEmailAsync(verifiedEmail, operationToken);
            if (success)
            {
                MudDialog.Close();
            }
            else
            {
                _error = error;
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToPasswordAuth()
    {
        _error = null;
        _codeSent = false;
        _verificationToken = null;
        _code = string.Empty;
        _sessionToken = null;
        _modifySessionToken = null;
        _password = string.Empty;
        _twoFactorStatus = null;
        _totpCode = string.Empty;
        _emailCode = string.Empty;
        _recoveryCode = string.Empty;
        _emailCodeSent = false;
        _emailChallengeToken = null;
        _step = Step.PasswordAuth;
        StateHasChanged();
    }

    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "邮箱不能为空";
        var trimmed = value.Trim();
        try
        {
            var addr = new System.Net.Mail.MailAddress(trimmed);
            return addr.Address == trimmed ? null : "邮箱格式无效";
        }
        catch (FormatException)
        {
            return "邮箱格式无效";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private enum Step
    {
        PasswordAuth,
        TwoFactorVerify,
        VerifyEmail
    }
}
