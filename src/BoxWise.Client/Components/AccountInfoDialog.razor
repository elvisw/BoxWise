@namespace BoxWise.Client.Components
@using MudBlazor
@inject AuthService AuthService
@inject AppState AppState

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">账户信息</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Color="Color.Error" Class="mb-2">@_error</MudText>
        }
        <MudTextField @bind-Value="_username" Label="用户名"
                      Variant="Variant.Outlined" Disabled="@_saving" />
        <MudTextField @bind-Value="_email" Label="邮箱"
                      Variant="Variant.Outlined" Disabled="@_saving" Class="mt-3"
                      HelperText="用于双因素认证的邮箱验证码"
                      Validation="@(new Func<string, string?>(ValidateEmail))" />
    </DialogContent>
    <DialogActions>
        @* 保存按钮：saving 时禁用；未修改时禁用（服务器错误后需修改字段重新激活） *@
        <MudButton OnClick="SaveAsync" Color="Color.Primary"
                   Variant="Variant.Filled" Disabled="@(_saving || (_username == _originalName && _email == _originalEmail))">保存</MudButton>
        <MudButton OnClick="Cancel">取消</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _username = "";
    private string _email = "";
    private string _originalName = "";
    private string _originalEmail = "";
    private string? _error;
    private bool _saving;

    protected override void OnInitialized()
    {
        _username = AppState.CurrentUserName ?? "";
        _email = AppState.CurrentUserEmail ?? "";
        _originalName = _username;
        _originalEmail = _email;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;

        var newEmail = _email != _originalEmail ? _email : null;
        var (success, error) = await AuthService.UpdateProfileAsync(_username, newEmail);
        _saving = false;

        if (success)
        {
            MudDialog.Close();
        }
        else
        {
            _error = error;
        }
    }

    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null; // 邮箱可选
        var trimmed = value.Trim();
        try
        {
            var addr = new System.Net.Mail.MailAddress(trimmed);
            return addr.Address == trimmed ? null : "邮箱格式无效";
        }
        catch (FormatException)
        {
            return "邮箱格式无效";
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
