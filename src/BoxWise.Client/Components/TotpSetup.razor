@namespace BoxWise.Client.Components
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudText Typo="Typo.body2" Class="mb-2">
    使用您的验证器应用扫描以下 QR 码或手动输入密钥。
</MudText>

@if (!string.IsNullOrEmpty(_secretKey))
{
    <div class="d-flex flex-column align-center mb-4">
        @if (!string.IsNullOrEmpty(_qrCodeUri))
        {
            <MudImage Src="@QrCodeImageUrl" Elevation="1" Class="mb-3"
                      Height="200" Width="200" />
        }

        <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-1">
            密钥（手动输入）：
        </MudText>
        <div class="d-flex align-center mb-2" style="gap: 8px;">
            <MudText Typo="Typo.body2" Style="font-family: monospace; font-size: 1.1rem; letter-spacing: 2px;"
                     Color="Color.Secondary">
                @_secretKey
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="CopySecretKeyAsync" />
        </div>
        <MudText Typo="Typo.caption" Color="Color.Default">
            推荐应用：Google Authenticator、Authy、Microsoft Authenticator
        </MudText>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
        @_error
    </MudAlert>
}

@if (_isVerified)
{
    <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true">
        验证成功！
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-2">
        设置完成后，输入验证器应用中的 6 位验证码以确认：
    </MudText>

    <MudTextField @bind-Value="_code"
                  Label="验证码"
                  Required="true"
                  Variant="Variant.Outlined"
                  Class="mb-3"
                  FullWidth="true"
                  HelperText="输入 6 位验证码" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Disabled="@(_isLoading || string.IsNullOrEmpty(_code) || _code.Length < 6)"
               @onclick="VerifyCodeAsync">
        @(_isLoading ? "验证中..." : "确认并启用")
    </MudButton>
}

@code {
    [Parameter]
    public string SessionToken { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnSetupComplete { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private string? _secretKey;
    private string? _qrCodeUri;
    private string _code = string.Empty;
    private string? _error;
    private bool _isLoading;
    private bool _isVerified;

    private string? QrCodeImageUrl =>
        !string.IsNullOrEmpty(_qrCodeUri)
            ? $"/api/qrcode?text={Uri.EscapeDataString(_qrCodeUri)}"
            : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadTotpSetupAsync();
    }

    private async Task LoadTotpSetupAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await AuthService.SetupTotpAsync(SessionToken);
            if (result.HasValue)
            {
                _secretKey = result.Value.SecretKey;
                _qrCodeUri = result.Value.QrCodeUri;
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyCodeAsync()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var success = await AuthService.VerifyTotpSetupAsync(SessionToken, _code);
            if (success)
            {
                _isVerified = true;
                Snackbar.Add("TOTP 双因素认证已启用", Severity.Success);
                await OnSetupComplete.InvokeAsync();
            }
            else
            {
                _error = "验证码无效，请确认输入的验证码正确";
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CopySecretKeyAsync()
    {
        if (!string.IsNullOrEmpty(_secretKey))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", _secretKey);
                Snackbar.Add("密钥已复制到剪贴板", Severity.Success);
            }
            catch
            {
                Snackbar.Add("复制失败，请手动复制密钥", Severity.Warning);
            }
        }
    }
}
