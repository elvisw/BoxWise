@using BoxWise.Shared.Dtos
@inject TagService TagService

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}
else if (_error)
{
    <MudText Typo="Typo.caption" Color="Color.Error">加载标签失败</MudText>
}
else if (!_hasData)
{
    <MudText Typo="Typo.caption" Color="Color.Default">暂无标签，录入物品时可自动创建</MudText>
}
else
{
    <MudChipSet T="int" SelectionMode="SelectionMode.MultiSelection"
                SelectedValues="SelectedTagIds"
                SelectedValuesChanged="OnSelectedValuesChanged">
        @foreach (var tag in _tags)
        {
            <MudChip Value="@tag.Id" Color="Color.Primary" Variant="Variant.Outlined">
                @tag.Name
            </MudChip>
        }
    </MudChipSet>
}

@code {
    [Parameter] public IReadOnlyCollection<int> SelectedTagIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback<IReadOnlyCollection<int>> SelectedTagIdsChanged { get; set; }

    private List<TagDto> _tags = [];
    private bool _hasData;
    private bool _loading = true;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tags = await TagService.GetAllAsync();
            _hasData = _tags.Count > 0;
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSelectedValuesChanged(IReadOnlyCollection<int> values)
    {
        SelectedTagIds = values;
        await SelectedTagIdsChanged.InvokeAsync(values);
    }
}
