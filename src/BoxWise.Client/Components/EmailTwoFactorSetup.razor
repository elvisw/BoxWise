@namespace BoxWise.Client.Components
@inject AuthService AuthService
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mb-4">
    输入您的邮箱地址以接收验证码。设置完成后，登录时将需要输入发送到该邮箱的验证码。
</MudText>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
        @_error
    </MudAlert>
}

@if (_isVerified)
{
    <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true">
        邮箱验证成功！
    </MudAlert>
}
else
{
    <MudTextField @bind-Value="_email"
                  Label="邮箱地址"
                  InputType="InputType.Email"
                  Required="true"
                  Immediate="true"
                  Variant="Variant.Outlined"
                  Class="mb-3"
                  FullWidth="true"
                  Disabled="@_codeSent"
                  HelperText="用于接收双因素认证验证码" />

    @if (!_codeSent)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@(_isLoading || string.IsNullOrEmpty(_email) || !_email.Contains('@'))"
                   @onclick="SendCodeAsync">
            @(_isLoading ? "发送中..." : "发送验证码")
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            验证码已发送至 @_email，请输入您收到的 6 位验证码。
        </MudText>

        <MudTextField @bind-Value="_code"
                      Label="验证码"
                      Required="true"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      FullWidth="true"
                      HelperText="输入 6 位验证码" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@(_isLoading || string.IsNullOrEmpty(_code) || _code.Length < 6)"
                   @onclick="VerifyCodeAsync">
            @(_isLoading ? "验证中..." : "确认并启用")
        </MudButton>
    }
}

@code {
    [Parameter]
    public string SessionToken { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<List<string>> OnSetupComplete { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private string _email = string.Empty;
    private string _code = string.Empty;
    private string? _emailToken;
    private string? _error;
    private bool _isLoading;
    private bool _codeSent;
    private bool _isVerified;

    private async Task SendCodeAsync()
    {
        _error = null;
        _isLoading = true;

        try
        {
            _emailToken = await AuthService.SetupEmailTwoFactorAsync(SessionToken, _email);
            _codeSent = true;
            Snackbar.Add("验证码已发送到您的邮箱", Severity.Info);
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyCodeAsync()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.VerifyEmailTwoFactorAsync(SessionToken, _code, _emailToken ?? "");
            if (result.Success)
            {
                _isVerified = true;
                Snackbar.Add("邮箱双因素认证已启用", Severity.Success);
                await OnSetupComplete.InvokeAsync(result.RecoveryCodes);
            }
            else
            {
                _error = "验证码无效，请确认输入的验证码正确";
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
