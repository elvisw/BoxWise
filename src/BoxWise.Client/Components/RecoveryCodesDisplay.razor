@namespace BoxWise.Client.Components
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Warning" Class="mr-2" />
            恢复码
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            <MudText Typo="Typo.body2">
                请立即保存以下恢复码。每个恢复码仅能使用一次。
                如果无法访问您的 2FA 设备且没有恢复码，您将无法登录账户。
            </MudText>
        </MudAlert>

        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
            <MudText Typo="Typo.body2">
                使用恢复码登录后，双因素认证将被清除。您需要重新设置 2FA。
            </MudText>
        </MudAlert>

        <div class="d-flex flex-column align-center" style="gap: 4px;">
            @foreach (var rc in Codes)
            {
                var capturedCode = rc;
                <MudPaper Class="pa-2" Elevation="0" Outlined="true" Style="width: 100%;">
                    <div class="d-flex align-center justify-space-between">
                        <MudText Typo="Typo.body2"
                                 Style="font-family: monospace; font-size: 1.1rem; letter-spacing: 2px;"
                                 Color="Color.Secondary">
                            @rc
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => CopyCodeAsync(capturedCode))" />
                    </div>
                </MudPaper>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="@DownloadCodesAsync" Class="mr-auto">
            下载为文本文件
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Check"
                   OnClick="@ConfirmSaved">
            我已安全保存
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public List<string> Codes { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private async Task CopyCodeAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Snackbar.Add("已复制到剪贴板", Severity.Success);
        }
        catch
        {
            Snackbar.Add("复制失败，请手动复制", Severity.Warning);
        }
    }

    private async Task DownloadCodesAsync()
    {
        var content = string.Join(Environment.NewLine, Codes);
        var text = $"BoxWise 双因素认证恢复码{Environment.NewLine}" +
                   $"生成时间：{DateTime.Now:yyyy-MM-dd HH:mm:ss}{Environment.NewLine}" +
                   $"{new string('-', 30)}{Environment.NewLine}{Environment.NewLine}{content}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("所有恢复码已复制，请粘贴到安全位置保存", Severity.Success);
        }
        catch
        {
            Snackbar.Add("请手动复制保存每个恢复码", Severity.Warning);
        }
    }

    private void ConfirmSaved()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
