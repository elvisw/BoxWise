<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>68b5e442-371d-4903-a2c0-a88c511e560c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BoxWise.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" />
    <PackageReference Include="Fido2.Models" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoxWise.Shared\BoxWise.Shared.csproj" />
    <ProjectReference Include="..\BoxWise.Client\BoxWise.Client.csproj" />
  </ItemGroup>

  <!-- 解决 Identity.UI 静态资产 favicon.ico 与 Client 项目的冲突 -->
  <Target Name="RemoveIdentityUIFaviconConflict" AfterTargets="ResolveProjectStaticWebAssets" BeforeTargets="ResolveStaticWebAssetsConflicts">
    <ItemGroup>
      <_IdFaviconAssets Include="@(StaticWebAsset)" Condition="'%(StaticWebAsset.SourceId)' == 'BoxWise.Server' and '%(StaticWebAsset.Filename)' == 'favicon'" />
    </ItemGroup>
    <ItemGroup>
      <StaticWebAsset Remove="@(_IdFaviconAssets)" />
    </ItemGroup>
    <Message Importance="high" Text="Removed @(_IdFaviconAssets->Count()) Identity.UI favicon asset(s) to resolve conflict" />
  </Target>


</Project>
