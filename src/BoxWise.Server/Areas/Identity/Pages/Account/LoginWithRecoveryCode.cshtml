@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "恢复码验证";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    您已请求使用恢复码登录。在下次登录时提供验证器应用验证码或禁用双重验证并重新登录前，此次登录将不会被记住。
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="恢复码" />
                <label asp-for="Input.RecoveryCode" class="form-label">恢复码</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">登录</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}