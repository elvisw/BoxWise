@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "双重验证";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>您没有剩余的恢复码。</strong>
                    <p>您必须<a asp-page="./GenerateRecoveryCodes">生成一组新的恢复码</a>，然后才能使用恢复码登录。</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>您剩余 1 个恢复码。</strong>
                    <p>您可以<a asp-page="./GenerateRecoveryCodes">生成一组新的恢复码</a>。</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>您剩余 @Model.RecoveryCodesLeft 个恢复码。</strong>
                    <p>建议您<a asp-page="./GenerateRecoveryCodes">生成一组新的恢复码</a>。</p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-primary">忘记此浏览器</button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn btn-primary">禁用 2FA</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">重置恢复码</a>
        }

        <h4>验证器应用</h4>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">添加验证器应用</a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">设置验证器应用</a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">重置验证器应用</a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>隐私和 Cookie 政策尚未接受。</strong>
            <p>您必须先接受政策才能启用双重验证。</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
