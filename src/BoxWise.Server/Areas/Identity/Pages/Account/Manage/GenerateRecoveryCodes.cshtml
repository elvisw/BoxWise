@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "生成双重验证恢复码";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@if (Model.RecoveryCodes != null && Model.RecoveryCodes.Length > 0)
{
    <div class="alert alert-success" role="alert">
        <p><strong>请将这些恢复码保存在安全的地方。</strong></p>
        <p>如果您丢失了设备且没有恢复码，将无法访问您的账户。</p>
    </div>
    <div>
        <pre class="bg-light p-3 border rounded"><code>@foreach (var code in Model.RecoveryCodes)
{
    @code<br />
}</code></pre>
    </div>
}
else
{
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>请将这些恢复码保存在安全的地方。</strong>
    </p>
    <p>
        如果您丢失了设备且没有恢复码，将无法访问您的账户。
    </p>
    <p>
        生成新的恢复码不会更改验证器应用中使用的密钥。如果您想更改验证器应用中使用的密钥，应<a asp-page="./ResetAuthenticator">重置您的验证器密钥。</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">生成恢复码</button>
    </form>
</div>
}
