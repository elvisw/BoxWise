@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "重置验证器密钥";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>重置验证器密钥后，验证器应用将无法使用，直至您重新配置。</strong>
    </p>
    <p>
        此过程将禁用 2FA，直至您验证验证器应用。
        如果您未完成验证器应用配置，可能会失去对账户的访问权限。
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">重置验证器密钥</button>
    </form>
</div>
