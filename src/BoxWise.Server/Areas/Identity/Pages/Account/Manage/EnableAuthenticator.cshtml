@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "配置验证器应用";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>要使用验证器应用，请按照以下步骤操作：</p>
    <ol class="list">
        <li>
            <p>
                下载双重验证器应用，例如适用于
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> 和
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> 的 Microsoft Authenticator，
                或适用于
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> 和
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a> 的 Google Authenticator。
            </p>
        </li>
        <li>
            <p>扫描二维码或将此密钥 <kbd>@Model.SharedKey</kbd> 输入到您的双重验证器应用中。空格和大小写不敏感。</p>
            <div class="alert alert-info">了解如何<a href="https://go.microsoft.com/fwlink/?Linkid=852423">启用二维码生成</a>。</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                扫描二维码或输入上述密钥后，您的双重验证应用将提供一个唯一验证码。请在下方确认框中输入该验证码。
            </p>
            <div class="row">
                <div class="col-md-8">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="请输入验证码。"/>
                            <label asp-for="Input.Code" class="control-label form-label">验证码</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">验证</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.min.js">
    </script>
    <script>
        new QRCode(document.getElementById("qrCode"), {
            text: document.getElementById("qrCodeData").getAttribute("data-url"),
            width: 200,
            height: 200
        });
    </script>
}
