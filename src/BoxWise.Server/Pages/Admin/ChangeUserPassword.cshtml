@page "/admin/{id}/password"
@model BoxWise.Server.Pages.Admin.ChangeUserPasswordModel
@{
    ViewData["Title"] = "修改密码";
}

<h2>修改密码 — @Model.TargetUsername</h2>

@if (Model.ErrorMessage is not null)
{
    <div class="error-message">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="form-group">
        <label for="password">新密码</label>
        <input type="password" id="password" name="NewPassword" required minlength="4" />
    </div>
    <button type="submit" class="btn btn-primary">保存密码</button>
    <a href="/admin" class="btn btn-link">返回列表</a>
</form>
