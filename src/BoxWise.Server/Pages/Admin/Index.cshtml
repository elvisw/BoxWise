@page "/admin"
@model BoxWise.Server.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "账户列表";
}

<h2>账户列表</h2>

<div class="actions">
    <a href="/admin/create" class="btn btn-primary">+ 创建账户</a>
</div>

@if (Model.Users.Count == 0)
{
    <p>暂无用户。</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>用户名</th>
                <th>角色</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.IsAdmin)
                        {
                            <span class="badge badge-admin">管理员</span>
                        }
                        else
                        {
                            <span class="badge badge-user">成员</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
