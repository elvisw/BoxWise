@page "/admin"
@model BoxWise.Server.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "账户列表";
}

<h2>账户列表</h2>

@if (Model.IsAdminPasswordManagedByEnv)
{
    <div class="warning-banner"><code>admin</code> 账户密码由环境变量 <code>Admin__Password</code> 管理，通过界面修改后，服务重启将恢复为环境变量中的密码。</div>
}

@if (Model.StatusMessage is not null)
{
    <div class="status-message">@Model.StatusMessage</div>
}

<div class="actions">
    <a href="/admin/create" class="btn btn-primary">+ 创建账户</a>
    <a href="/admin/smtp-settings" class="btn btn-outline">SMTP 设置</a>
    <a href="/admin/llm-config" class="btn btn-outline">LLM 设置</a>
</div>

@if (Model.Users.Count == 0)
{
    <p>暂无用户。</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>用户名</th>
                <th>角色</th>
                <th>2FA 状态</th>
                <th style="width:340px;">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.IsAdmin)
                        {
                            <span class="badge badge-admin">管理员</span>
                        }
                        else
                        {
                            <span class="badge badge-user">成员</span>
                        }
                    </td>
                    <td>
                        @if (user.TwoFactorEnabled)
                        {
                            <span class="badge badge-2fa-enabled">已启用 (@user.ConfiguredMethods)</span>
                        }
                        else if (!string.IsNullOrEmpty(user.ConfiguredMethods))
                        {
                            <span class="badge badge-2fa-partial">未完成</span>
                        }
                        else
                        {
                            <span class="badge badge-2fa-disabled">—</span>
                        }
                    </td>
                    <td>
                        <a href="/admin/@user.Id/edit" class="btn btn-sm btn-outline">编辑</a>
                        <a href="/admin/@user.Id/password" class="btn btn-sm btn-outline">改密</a>
                        <form method="post" asp-page-handler="ToggleRole" asp-route-id="@user.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline">@(user.IsAdmin ? "取消管理" : "设为管理")</button>
                        </form>
                        @if (!string.IsNullOrEmpty(user.ConfiguredMethods))
                        {
                            <a href="/admin/@user.Id/reset-2fa" class="btn btn-sm btn-outline btn-2fa-reset">重置 2FA</a>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline"
                              onsubmit="return confirm('确定删除此账户吗？此操作不可撤销。')">
                            <button type="submit" class="btn btn-sm btn-danger">删除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
